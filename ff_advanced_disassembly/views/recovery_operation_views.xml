<odoo>
    <record id="ff_recovery_operation_list_view" model="ir.ui.view">
        <field name="name">ff.recovery.operation.list</field>
        <field name="model">ff.recovery.operation</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'done'" decoration-muted="state == 'cancelled'">
                <field name="name"/>
                <field name="operation_type"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="input_carrying_value" groups="account.group_account_user,mrp.group_mrp_manager"/>
                <field name="recoverable_value" groups="account.group_account_user,mrp.group_mrp_manager"/>
                <field name="state" widget="badge"/>
                <field name="executed_at"/>
            </list>
        </field>
    </record>
    <record id="ff_recovery_operation_form_view" model="ir.ui.view">
        <field name="name">ff.recovery.operation.form</field>
        <field name="model">ff.recovery.operation</field>
        <field name="arch" type="xml">
            <form string="Recovery and Recycling Operation">
                <header>
                    <button name="action_prepare" string="Validate" type="object" class="oe_highlight" data-hotkey="v" invisible="state != 'draft'"/>
                    <button name="action_execute" string="Execute Recovery" type="object" class="oe_highlight" data-hotkey="e" invisible="state != 'ready'"/>
                    <button name="action_reverse" string="Reverse Operation" type="object" invisible="state != 'done'" confirm="This creates new reversing stock moves. Continue?" groups="mrp.group_mrp_manager"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,ready,done"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name" placeholder="Recovery Operation" nolabel="1"/></h1></div>
                    <group col="2">
                        <group>
                            <field name="operation_type" help="حدد هل العملية إعادة تدوير أم تفكيك مع إعادة تدوير."/>
                            <field name="recipe_id" help="وصفة اختيارية تملأ المخرجات المتوقعة تلقائيًا."/>
                            <button name="action_apply_recipe" string="Apply Recipe" type="object" class="oe_link" invisible="not recipe_id or state != 'draft'"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="source_location_id" options="{'no_create': True}" help="المكان الذي توجد فيه الكمية قبل بدء العملية."/>
                            <field name="processing_location_id" options="{'no_create': True}" readonly="1" help="موقع فني داخلي يمثل مرحلة المعالجة؛ يحدده النظام تلقائيًا."/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Inputs">
                            <field name="source_line_ids" readonly="state != 'draft'">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="product_id"/>
                                    <field name="quantity"/>
                                    <field name="uom_id"/>
                                    <field name="lot_id" optional="hide"/>
                                </list>
                            </field>
                        </page>
                        <page string="Actual Outputs">
                            <field name="output_line_ids" readonly="state != 'draft'">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="product_id"/>
                                    <field name="output_type"/>
                                    <field name="quantity"/>
                                    <field name="expected_quantity"/>
                                    <field name="uom_id"/>
                                    <field name="allocation_weight" optional="hide"/>
                                    <field name="loss_class" optional="hide" invisible="output_type != 'waste'"/>
                                    <field name="destination_location_id"/>
                                    <field name="lot_id" optional="hide"/>
                                    <field name="allocated_value" groups="account.group_account_user,mrp.group_mrp_manager"/>
                                </list>
                            </field>
                        </page>
                        <page string="Recoverable Value Policy">
                            <group string="Recoverable Value Policy" col="2">
                                <field name="recoverable_value_mode"/>
                                <field name="recoverable_value_percentage" invisible="recoverable_value_mode != 'percentage'"/>
                                <field name="recoverable_target_amount" invisible="recoverable_value_mode != 'amount'"/>
                            </group>
                        </page>
                        <page string="Valuation Reconciliation" groups="account.group_account_user,mrp.group_mrp_manager" invisible="state not in ['done', 'reversed']">
                            <group>
                                <field name="input_carrying_value"/>
                                <field name="recoverable_value"/>
                                <field name="allocated_output_value"/>
                                <field name="actual_output_value"/>
                                <field name="normal_loss_value"/>
                                <field name="abnormal_loss_value"/>
                                <field name="valuation_difference"/>
                                <field name="account_move_id"/>
                                <field name="reversal_account_move_id" invisible="not reversal_account_move_id"/>
                                <field name="reverse_move_ids"/>
                            </group>
                        </page>
                        <page string="Notes"><field name="notes"/></page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="ff_recovery_operation_search_view" model="ir.ui.view">
        <field name="name">ff.recovery.operation.search</field>
        <field name="model">ff.recovery.operation</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="operation_type"/>
                <field name="state"/>
                <field name="company_id"/>
                <filter name="open" string="Open" domain="[('state', 'in', ['draft', 'ready', 'executing'])]"/>
                <filter name="completed" string="Completed" domain="[('state', '=', 'done')]"/>
                <group>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_ff_recovery_operation" model="ir.actions.act_window">
        <field name="name">Recovery Operations</field>
        <field name="res_model">ff.recovery.operation</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="ff_recovery_operation_search_view"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a recovery operation</p>
            <p>Record recovered outputs, documented losses, and the stock traceability in one controlled workflow.</p>
        </field>
    </record>

    <record id="ff_recovery_recipe_list_view" model="ir.ui.view">
        <field name="name">ff.recovery.recipe.list</field>
        <field name="model">ff.recovery.recipe</field>
        <field name="arch" type="xml">
            <list><field name="name"/><field name="code"/><field name="input_product_id"/><field name="expected_yield"/><field name="company_id" groups="base.group_multi_company"/><field name="active"/></list>
        </field>
    </record>
    <record id="ff_recovery_recipe_form_view" model="ir.ui.view">
        <field name="name">ff.recovery.recipe.form</field>
        <field name="model">ff.recovery.recipe</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group col="2">
                        <group><field name="name"/><field name="code"/><field name="company_id" groups="base.group_multi_company"/></group>
                        <group><field name="input_product_id"/><field name="expected_yield"/><field name="active"/></group>
                    </group>
                    <field name="line_ids">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="product_id"/>
                            <field name="expected_quantity"/>
                            <field name="uom_id"/>
                            <field name="output_type"/>
                            <field name="loss_class" optional="hide" invisible="output_type != 'waste'"/>
                            <field name="allocation_weight" optional="hide"/>
                            <field name="destination_location_id"/>
                        </list>
                    </field>
                    <field name="notes"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_ff_recovery_recipe" model="ir.actions.act_window">
        <field name="name">Recovery Recipes</field>
        <field name="res_model">ff.recovery.recipe</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a recovery recipe</p>
            <p>Define the expected outputs once and reuse them when preparing recovery operations.</p>
        </field>
    </record>
</odoo>
