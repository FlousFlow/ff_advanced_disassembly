<odoo>
    <!-- The module has its own visible permission scope in the Odoo 20 Users
         form. The implied native roles provide the underlying stock/MRP
         capabilities without making those native roles grant this addon. -->
    <record id="res_groups_privilege_advanced_disassembly" model="res.groups.privilege">
        <field name="name">Advanced Disassembly</field>
        <field name="sequence">6</field>
        <field name="category_id" ref="base.module_category_supply_chain"/>
        <field name="description">Roles for advanced disassembly, recovery, recycling, and valuation controls.</field>
    </record>
    <record id="group_ff_disassembly_user" model="res.groups">
        <field name="name">Advanced Disassembly User</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_advanced_disassembly"/>
        <field name="implied_ids" eval="[(4, ref('mrp.group_mrp_user'))]"/>
    </record>
    <record id="group_ff_disassembly_cost_viewer" model="res.groups">
        <field name="name">Advanced Disassembly Cost Viewer</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_advanced_disassembly"/>
        <field name="implied_ids" eval="[(4, ref('group_ff_disassembly_user'))]"/>
    </record>
    <record id="group_ff_disassembly_administrator" model="res.groups">
        <field name="name">Advanced Disassembly Administrator</field>
        <field name="sequence">30</field>
        <field name="privilege_id" ref="res_groups_privilege_advanced_disassembly"/>
        <field name="comment">Configure advanced disassembly, execute recovery operations, view valuation, and reverse completed operations.</field>
        <field name="implied_ids" eval="[(4, ref('group_ff_disassembly_cost_viewer')), (4, ref('mrp.group_mrp_manager'))]"/>
    </record>
</odoo>
